{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": true,

		"skipLibCheck": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "cli", "tools"]
}
