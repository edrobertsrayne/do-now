# Copy to .env for local use; in Dokploy set these in the service's Environment tab.

# SQLite database file. Its directory must be on a persistent volume and writable
# (node:sqlite also creates -wal and -shm files beside it).
DB_PATH=/app/data/retrieval.db

# Public origin of the site. Required behind a proxy (Traefik on Dokploy) or form posts fail.
ORIGIN=https://do-now.example.com

# Optional
# PORT=3000
# BANK_DIR=/app/bank
